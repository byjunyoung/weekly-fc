---
import '../styles/tokens.css';
import { href } from '../lib/url';
import TopbarActions from '../react/shell/TopbarActions.tsx';
interface Props { title: string; index?: boolean; wide?: boolean; description?: string }
const { title, index = false, wide = false, description = 'WEEKLY FC — 매주 모이는 풋살 팀의 포탈' } = Astro.props;
const nav = [
  { href: href('/'), label: '홈' },
  { href: href('/squad/'), label: '명단' },
  { href: href('/lineup/'), label: '라인업' },
  { href: href('/teams/'), label: '팀짜기' },
  { href: href('/rules/'), label: '운영 규칙' },
];
const path = Astro.url.pathname;
const isActive = (h: string) => (h === href('/') ? path === href('/') : path.startsWith(h));
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · WEEKLY FC</title>
  <meta name="description" content={description} />
  {!index && <meta name="robots" content="noindex" />}
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <!-- antd 부품 CSS — prebuild 가 테마를 넣어 뽑는다. 화면은 zeroRuntime 이라 이게 첫 페인트의 antd 스타일 전부다. -->
  <link rel="stylesheet" href={href('/antd.css')} />
  <slot name="head" />
</head>
<body class:list={[{ wide }]}>
  <header class="topbar">
    <a class="mark" href={href('/')}>WEEKLY<b>FC</b></a>
    <nav class="topnav">
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: isActive(n.href) }]}><span>{n.label}</span></a>
      ))}
    </nav>
    <div class="topbar-act">
      <TopbarActions client:load />
    </div>
  </header>
  <main class="main">
    <p class="warn load-err" id="inapp-note" hidden><span id="inapp-msg"></span> · <button id="inapp-open">다시 열기</button></p>
    <p class="warn load-err" id="load-err" hidden>데이터를 불러오지 못했습니다 · <button id="load-err-retry">다시 시도</button><button id="load-err-open" hidden>기본 브라우저로 열기</button></p>
    <slot />
  </main>

  <script>
    import { refresh } from '../lib/api';
    import { detectInApp, escapeUrl, shouldAutoEscape, ESCAPE_KEY } from '../lib/inapp';
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const loadErr = $('load-err');
    $('load-err-retry').onclick = () => { refresh().catch(() => {}); };
    window.addEventListener('wfc:error', () => { loadErr.hidden = false; });
    window.addEventListener('wfc:data', () => { loadErr.hidden = true; });

    // 탑바 높이는 폭에 따라 64px·115px 로 바뀐다(좁으면 탭이 제 줄로 내려간다). 그 아래에
    // 붙는 sticky 요소가 탑바 뒤로 숨지 않게 실제 높이를 --topbar-h 로 내보낸다.
    const bar = document.querySelector<HTMLElement>('.topbar');
    if (bar) {
      const putBarH = () => document.documentElement.style.setProperty('--topbar-h', `${bar.offsetHeight}px`);
      putBarH();
      new ResizeObserver(putBarH).observe(bar);
    }

    // 인앱 브라우저 — 카톡에서는 구글 Apps Script 요청이 응답 없이 멈춘다(2026-09-22 확인).
    // 확인된 카톡만 밖으로 내보내고, 다른 인앱은 실제로 데이터가 안 왔을 때만 길을 알려 준다.
    const inApp = detectInApp(navigator.userAgent);
    const out = inApp ? escapeUrl(inApp, location.href) : null;
    if (out) {
      const open = () => { location.href = out; };
      $('inapp-open').onclick = open;
      ($('load-err-open') as HTMLButtonElement).onclick = open;
      $('load-err-open').hidden = false;
      if (shouldAutoEscape(inApp, location.search)) {
        // 밖에서 뒤로가기로 돌아왔을 때 또 튕기지 않게 한 번만 — 저장소가 막힌 기기도 있어
        // 실패하면 그냥 안 걸러진다(전환 자체는 되는 편이 낫다).
        let tried = false;
        try { tried = sessionStorage.getItem(ESCAPE_KEY) === '1'; } catch {}
        $('inapp-msg').textContent = `${inApp!.name} 안에서는 명단을 불러오지 못해 기본 브라우저로 넘겼습니다`;
        $('inapp-note').hidden = false;
        if (!tried) {
          try { sessionStorage.setItem(ESCAPE_KEY, '1'); } catch {}
          open();
        }
      }
    }
  </script>
</body>
</html>
