---
import '../styles/tokens.css';
import { href } from '../lib/url';
import TopbarActions from '../react/shell/TopbarActions.tsx';
interface Props { title: string; index?: boolean; wide?: boolean; description?: string; ogImage?: string }
const { title, index = false, wide = false, description = 'WEEKLY FC — 매주 모이는 풋살 팀의 포탈', ogImage = '/og.png' } = Astro.props;
// 카톡·슬랙 링크 미리보기(2026-09-26 "링크에 썸네일이 없다"). og:image 는 절대 주소여야 한다 — 상대 경로는 카톡이 못 읽는다.
const SITE = 'https://byjunyoung.github.io';
const ogUrl = SITE + href(Astro.url.pathname.startsWith('/weekly-fc') ? Astro.url.pathname.slice('/weekly-fc'.length) || '/' : Astro.url.pathname);
const ogImg = SITE + href(ogImage);
const nav = [
  { href: href('/'), label: '홈' },
  { href: href('/squad/'), label: '명단' },
  { href: href('/lineup/'), label: '라인업' },
  { href: href('/matches/'), label: '매치' },
  { href: href('/tier/'), label: '티어' },
  { href: href('/tactics/'), label: '전술' },
  { href: href('/rules/'), label: '운영 규칙' },
];
const path = Astro.url.pathname;
const isActive = (h: string) => (h === href('/') ? path === href('/') : path.startsWith(h));
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · WEEKLY FC</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WEEKLY FC" />
  <meta property="og:title" content={`${title} · WEEKLY FC`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} · WEEKLY FC`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />
  {!index && <meta name="robots" content="noindex" />}
  <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <!-- antd 부품 CSS — prebuild 가 테마를 넣어 뽑는다. 화면은 zeroRuntime 이라 이게 첫 페인트의 antd 스타일 전부다. -->
  <link rel="stylesheet" href={href('/antd.css')} />
  <slot name="head" />
</head>
<body class:list={[{ wide }]}>
  <header class="topbar">
    <a class="mark" href={href('/')}>WEEKLY<b>FC</b></a>
    <nav class="topnav">
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: isActive(n.href) }]}><span>{n.label}</span></a>
      ))}
    </nav>
    <div class="topbar-act">
      <TopbarActions client:load />
    </div>
  </header>
  <main class="main">
    <p class="warn load-err" id="load-err" hidden>데이터를 불러오지 못했습니다 · <button id="load-err-retry">다시 시도</button><button id="load-err-open" hidden>기본 브라우저로 열기</button></p>
    <slot />
  </main>

  <script>
    import { refresh } from '../lib/api';
    import { detectInApp, escapeUrl } from '../lib/inapp';
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const loadErr = $('load-err');
    $('load-err-retry').onclick = () => { refresh().catch(() => {}); };
    window.addEventListener('wfc:error', () => { loadErr.hidden = false; });
    window.addEventListener('wfc:data', () => { loadErr.hidden = true; });

    // 탑바 높이는 폭에 따라 64px·115px 로 바뀐다(좁으면 탭이 제 줄로 내려간다). 그 아래에
    // 붙는 sticky 요소가 탑바 뒤로 숨지 않게 실제 높이를 --topbar-h 로 내보낸다.
    const bar = document.querySelector<HTMLElement>('.topbar');
    if (bar) {
      const putBarH = () => document.documentElement.style.setProperty('--topbar-h', `${bar.offsetHeight}px`);
      putBarH();
      new ResizeObserver(putBarH).observe(bar);
    }

    // 폰에선 탭 줄을 가로로 민다(2026-09-24 여섯 탭) — 지금 탭이 보이게 밀어 두고, 오른쪽에 더 있으면 끝을 흐린다.
    const tabs = document.querySelector<HTMLElement>('.topnav');
    if (tabs) {
      const on = tabs.querySelector<HTMLElement>('a.active');
      if (on && on.offsetLeft + on.offsetWidth > tabs.clientWidth) tabs.scrollLeft = on.offsetLeft - tabs.clientWidth / 2 + on.offsetWidth / 2;
      const hint = () => tabs.classList.toggle('is-more', tabs.scrollLeft + tabs.clientWidth < tabs.scrollWidth - 2);
      hint();
      tabs.addEventListener('scroll', hint, { passive: true });
      window.addEventListener('resize', hint);
    }

    // 인앱 브라우저 — 데이터를 못 불러왔을 때만 기본 브라우저로 여는 버튼을 보여 준다.
    // (카톡 자동 전환은 Supabase 로 옮긴 뒤 멈춤이 사라져 걷어냈다, 2026-09-24)
    const inApp = detectInApp(navigator.userAgent);
    const out = inApp ? escapeUrl(inApp, location.href) : null;
    if (out) {
      ($('load-err-open') as HTMLButtonElement).onclick = () => { location.href = out; };
      $('load-err-open').hidden = false;
    }
  </script>
</body>
</html>
