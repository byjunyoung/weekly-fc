---
// 게임 목록의 카드 줄 — 2D 모드·3D 모드 페이지가 함께 쓴다. 카드는 게임 등록부(src/lib/games/registry.ts)에서 온다
// (2026-11-07 "게임 메뉴는 아래 게임 여러개 고를 수 있게 만들고 만든 게임은 거기에 하나씩 추가하자").
import { href } from '../lib/url';
interface Props { games: { to: string; name: string; desc: string; tags: string[] }[] }
const { games } = Astro.props;
---
<div class="games-grid">
  {games.map((g) => (
    <a class="card games-card" href={href(g.to)}>
      <b class="games-name">{g.name}</b>
      <span class="games-desc">{g.desc}</span>
      <span class="games-tags">{g.tags.map((t) => <span class="games-tag">{t}</span>)}</span>
    </a>
  ))}
</div>
