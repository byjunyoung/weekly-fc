---
import Shell from '../layouts/Shell.astro';
---
<Shell title="축구 전술판" index={true} wide={true} description="무료 온라인 축구·풋살 전술판. 포메이션, 선수 배치, 화살표·존 드로잉. 설치 없이 브라우저에서.">
  <Fragment slot="head">
    <link rel="canonical" href="https://byjunyoung.github.io/weekly-fc/tactics/" />
    <meta name="keywords" content="축구 전술판, 온라인 전술판, 무료 전술판, 풋살 전술판, 7인제 전술판, 축구 포메이션, 전술 보드, football tactics board, soccer tactics board, free tactics board, online tactics board, soccer formation" />
    <meta property="og:title" content="무료 온라인 축구 전술판 | Football Tactics Board" />
    <meta property="og:description" content="설치 없이 바로 쓰는 무료 축구 전술판. 포메이션 설정, 선수 배치, 화살표·존·펜 드로잉. 축구·풋살·7인제 지원." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://byjunyoung.github.io/weekly-fc/tactics/" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="무료 온라인 축구 전술판" />
    <meta name="twitter:description" content="설치 없이 바로 쓰는 무료 축구 전술판. 포메이션·화살표·존·펜 드로잉 지원." />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: '축구 전술판 · Football Tactics Board', alternateName: 'Football Tactics Board', url: 'https://byjunyoung.github.io/weekly-fc/tactics/', applicationCategory: 'SportsApplication', operatingSystem: 'Any', featureList: ['포메이션 설정', '선수 배치 및 이동', '화살표 드로잉', '존 표시', '펜 드로잉', '축구·풋살·7인제 지원', '모바일 지원'], offers: { '@type': 'Offer', price: '0' }, description: '포메이션 설정, 선수 배치, 화살표·존·펜 드로잉을 지원하는 무료 온라인 축구·풋살 전술판' })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
      { '@type': 'Question', name: '무료 온라인 축구 전술판은 어디서 쓸 수 있나요?', acceptedAnswer: { '@type': 'Answer', text: 'byjunyoung.github.io/weekly-fc/tactics 에서 설치 없이 무료로 바로 사용할 수 있습니다. 모바일과 PC 모두 지원합니다.' } },
      { '@type': 'Question', name: '풋살 전술판도 지원하나요?', acceptedAnswer: { '@type': 'Answer', text: '네, 축구(11인제), 풋살(5인제), 7인제를 모두 지원합니다. 상단 탭에서 모드를 전환할 수 있습니다.' } },
      { '@type': 'Question', name: '어떤 포메이션을 설정할 수 있나요?', acceptedAnswer: { '@type': 'Answer', text: '4-3-3, 4-4-2, 4-2-3-1, 3-5-2, 5-3-2, 4-5-1, 3-4-3 등 자주 쓰는 포메이션을 제공합니다. 인원수 조절로 다양한 포메이션을 사용할 수 있습니다.' } },
      { '@type': 'Question', name: '전술판에서 화살표나 선을 그릴 수 있나요?', acceptedAnswer: { '@type': 'Answer', text: '네, 화살표 도구로 움직임을 표시하고, 존 도구로 구역을 표시하고, 펜 도구로 자유롭게 드로잉할 수 있습니다.' } },
    ] })} />
  </Fragment>
  <div id="board" class="board">
    <div class="page-head"><h1>전술판</h1><div class="actions" id="squad-actions"></div></div>

    <div id="tip"></div>

    <div id="player-edit">
      <div class="label" id="player-edit-label">선수 수정</div>
      <input type="number" id="player-num-input" min="1" max="99" maxlength="2" placeholder="번호">
      <input type="text" id="player-pos-input" maxlength="6" placeholder="포지션 (예: GK, ST)">
      <div class="foot">
        <button id="edit-cancel">취소</button>
        <button class="primary" id="edit-ok">확인</button>
      </div>
    </div>

    <header class="row">
      <div class="row" id="mode-row">
        <button class="primary" id="m-soccer">축구</button>
        <button id="m-futsal">풋살</button>
      </div>
      <div class="row" id="team-row">
        <input type="color" id="home-color" value="#ffffff" title="홈 팀 색상" style="width:var(--ctrl);height:var(--ctrl)">
        <select id="home-form"></select>
        <span class="label">HOME · vs · AWAY</span>
        <select id="away-form"></select>
        <input type="color" id="away-color" value="#1a1a1a" title="어웨이 팀 색상" style="width:var(--ctrl);height:var(--ctrl)">
      </div>
      <div class="row" id="count-row">
        <span class="label">인원</span>
        <button id="cnt-minus">−</button>
        <span id="count-val">11</span>
        <button id="cnt-plus">+</button>
      </div>
    </header>

    <main>
      <div id="pitch-container">
        <canvas id="pitch"></canvas>
      </div>
    </main>

    <footer class="row">
      <div class="row" id="tool-row">
        <button class="primary" id="tool-arrow"
          title="화살표 도구: 빈 공간을 드래그해 화살표를 그립니다 (데스크톱: 기본 동작)">↗ 화살표</button>
        <button id="tool-zone"
          title="존 도구: 빈 공간을 드래그해 구역을 표시합니다 (데스크톱: 우클릭 드래그)">▭ 존</button>
        <button id="tool-pen"
          title="펜 도구: 빈 공간을 드래그해 자유롭게 그립니다">✏ 펜</button>
      </div>
      <span class="muted" id="hint-text" style="font-size:var(--fs-sm)">
        선수 드래그: 이동 &nbsp;·&nbsp; 빈 공간 드래그: 화살표 &nbsp;·&nbsp; 우클릭 드래그: 존 &nbsp;·&nbsp; 선수 클릭: 번호 수정
      </span>
      <div class="row" id="zoom-row">
        <button id="orient-btn" title="가로형으로 전환">↔</button>
        <button id="zoom-minus" title="축소">−</button>
        <span id="zoom-val">100%</span>
        <button id="zoom-plus" title="확대">+</button>
        <button id="zoom-reset" title="줌 리셋">리셋</button>
      </div>
      <button class="danger" id="clear-btn" title="화살표와 존을 모두 지웁니다">지우기</button>
    </footer>
  </div>
  <div class="modal-bg" id="squad-modal"><div class="modal"><h2>명단 불러오기</h2><p class="muted">고른 순서대로 홈 팀 자리에 들어갑니다. 인원 수만큼만.</p><div class="pick-list" id="squad-list"></div><div class="foot"><button data-close="squad-modal">취소</button><button class="primary" id="squad-ok">배치</button></div></div></div>
  <div class="modal-bg" id="save-modal"><div class="modal"><h2>라인업 저장</h2><label>매치<select id="save-match" style="width:100%"></select></label><div class="foot"><button data-close="save-modal">취소</button><button class="primary" id="save-ok">저장</button></div></div></div>
</Shell>
<style is:global>
  /* 원본 tactics-board(bloglish/tactics-board) 이식판을 포털 어휘로 수렴: 모드·도구는 button(선택 시 .primary),
     라벨은 .label을 그대로 쓰고, 여기 남는 건 .board 전용 레이아웃 크롬(높이 calc, 헤더·푸터 바, 캔버스, 팝업 위치)뿐이다.
     캔버스 내부 색은 pitch.ts에서 토큰을 읽어 그린다. */
  .board, .board * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  .board { background: var(--surface); color: var(--fg); height: calc(100dvh - var(--header-h) - var(--pad) * 2); display: flex; flex-direction: column; overflow: hidden; }
  /* .board는 Shell의 .main 안에 있다 — .main의 상하 padding과, 이 페이지는 항상 wide라 모든 폭에서 노출되는 sticky .mhead 높이를 100dvh에서 뺀다. */
  @media (max-width: 899px) { .board { height: calc(100dvh - var(--header-h) - var(--gap) * 2); } }
  @media (max-width: 699px) { .board { height: calc(100dvh - var(--header-h) - var(--gap) * 2); } }

  /* ── HEADER / FOOTER: 가로 배치는 .row가 맡고, 여기엔 이 페이지만의 바(bar) 크롬만 남는다 ── */
  .board header { border-bottom: 1px solid var(--line); background: var(--bg); padding: 8px 16px; flex-shrink: 0; }
  .board footer { border-top: 1px solid var(--line); background: var(--bg); padding: 8px 16px; flex-shrink: 0; min-height: 52px; }
  .board #team-row { flex: 1; min-width: 180px; justify-content: center; }
  .board #hint-text { flex: 1; min-width: 0; line-height: 1.5; }

  /* ── MAIN ── */
  .board main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 16px; overflow: hidden; min-height: 0; }
  .board #pitch-container { position: relative; }
  .board canvas#pitch { display: block; touch-action: none; }

  /* ── PLAYER EDIT OVERLAY: .modal과 같은 틀(테두리·배경·여백)이지만 커서 옆에 뜨는 고정 위치 팝업이라 .modal 자체는 못 쓴다 ── */
  .board #player-edit {
    display: none; position: fixed; z-index: 300;
    background: var(--bg); border: 1px solid var(--line); padding: var(--gap);
    flex-direction: column; gap: 8px; min-width: 160px;
  }
  .board #player-edit.show { display: flex; }

  /* ── TOOLTIP ── */
  .board #tip { position: fixed; background: var(--fg); color: var(--bg); font-size: var(--fs-xs); padding: 4px 9px; pointer-events: none; opacity: 0; z-index: 99; white-space: nowrap; }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .board header, .board footer { padding: 6px 10px; gap: 6px; }
    .board #count-row { order: 1; margin-left: auto; }
    .board #team-row { order: 2; width: 100%; }

    .board footer { flex-wrap: nowrap; min-height: auto; }
    .board #hint-text { display: none; }
    .board #zoom-row { display: none; }
    .board footer .danger { margin-left: auto; }
  }

  @media (max-width: 360px) {
    .board #team-row .label { display: none; }
  }
</style>
<script>
  import { initPitch } from '../components/pitch';
  import { onData, isAdmin, write, serializeLineup } from '../lib/api';
  import { esc, fmtDate, toast } from '../lib/html';
  import type { Data } from '../lib/types';
  import type { PitchState } from '../components/lineup-svg';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) => (b.onclick = () => $(b.dataset.close!).classList.remove('show')));
  const api = initPitch($('board'));
  const wantMatch = new URLSearchParams(location.search).get('match');
  let data: Data | null = null, picked: number[] = [];
  let injected = false; // ?match= 라인업은 도착 시 한 번만 주입 — 그 뒤 renderActions가 다시 돌아도 진행 중인 작업을 덮지 않는다.
  const LOCAL = 'wfc_pitch_draft';
  try { const d = localStorage.getItem(LOCAL); if (d && !wantMatch) api.setState(JSON.parse(d) as PitchState); } catch {}
  window.addEventListener('beforeunload', () => { if (wantMatch) return; try { localStorage.setItem(LOCAL, JSON.stringify(api.getState())); } catch {} });
  function renderActions() {
    if (!data) return;
    $('squad-actions').innerHTML = `<button id="load-squad">명단 불러오기</button>${isAdmin() ? '<button id="save-lineup">매치에 저장</button>' : ''}`;
    $('load-squad').onclick = () => { picked = []; drawPick(); $('squad-modal').classList.add('show'); };
    if (isAdmin()) $('save-lineup').onclick = () => { ($('save-match') as HTMLSelectElement).innerHTML = data!.matches.map((m) => `<option value="${esc(m.id)}" ${m.id === wantMatch ? 'selected' : ''}>${fmtDate(m.date)}${m.location ? ` · ${esc(m.location)}` : ''}</option>`).join(''); $('save-modal').classList.add('show'); };
    if (wantMatch && !injected) { const l = data.lineups.find((x) => x.match_id === wantMatch); if (l) { try { api.setState(JSON.parse(l.assignments) as PitchState); injected = true; } catch {} } }
  }
  function drawPick() {
    $('squad-list').innerHTML = [...data!.players].sort((a, b) => a.num - b.num).map((p) => { const i = picked.indexOf(p.num); return `<button data-n="${p.num}" class="${i >= 0 ? 'primary' : ''}">${i >= 0 ? `${i + 1}. ` : ''}${p.num} ${esc(p.name)}</button>`; }).join('');
    $('squad-list').querySelectorAll<HTMLElement>('[data-n]').forEach((b) => (b.onclick = () => { const n = Number(b.dataset.n); picked = picked.includes(n) ? picked.filter((x) => x !== n) : [...picked, n]; drawPick(); }));
  }
  $('squad-ok').onclick = () => { const ps = picked.map((n) => data!.players.find((p) => p.num === n)!).map((p) => ({ n: p.num, name: p.name, pos: p.pos })); api.loadSquad('home', ps); $('squad-modal').classList.remove('show'); };
  $('save-ok').onclick = async () => {
    const match_id = ($('save-match') as HTMLSelectElement).value; if (!match_id) return;
    const existing = data!.lineups.find((l) => l.match_id === match_id);
    try { await write('writeLineup', serializeLineup({ id: existing?.id ?? String(Date.now()), match_id, name: '', formation: api.getState().formation.home, assignments: JSON.stringify(api.getState()) })); $('save-modal').classList.remove('show'); toast('저장됨'); } catch (e) { toast((e as Error).message); }
  };
  window.addEventListener('wfc:admin', renderActions);
  onData((d) => { data = d; renderActions(); });
</script>
