---
import Shell from '../../layouts/Shell.astro';
import Tabs from '../../components/Tabs.astro';
import { href } from '../../lib/url.ts';
import { DUTY_PER_MONTH } from '../../lib/rules.ts';
const tabs = [{ href: href('/record/'), label: '시즌' }, { href: href('/record/fines/'), label: '정산' }, { href: href('/record/duty/'), label: '봉사' }];
---
<Shell title="봉사">
  <div class="page-head"><h1>기록</h1><div class="actions"><div class="chips" id="year"></div></div></div>
  <Tabs items={tabs} />
  <p class="muted" style="margin:0 0 var(--gap)">시트 <code>rot</code> 순번대로 매월 {DUTY_PER_MONTH}명. 이번 달이 강조됩니다. 관리자는 당번을 바꾸거나 완료를 표시할 수 있습니다.</p>
  <div id="app" class="tbl-wrap"></div>
</Shell>
<script>
  import { onData, isAdmin, write, serializeRotation } from '../../lib/api.ts';
  import { esc, toast } from '../../lib/html.ts';
  import { yearRows } from '../../lib/rotation.ts';
  import type { Data, RotationRow } from '../../lib/types.ts';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  let data: Data | null = null;
  const now = new Date(); let year = now.getFullYear();
  function render() {
    if (!data) return;
    $('year').innerHTML = [year - 1, year, year + 1].map((y) => `<button class="chip ${y === year ? 'on' : ''}" data-y="${y}">${y}</button>`).join('');
    $('year').querySelectorAll<HTMLElement>('[data-y]').forEach((b) => (b.onclick = () => { year = Number(b.dataset.y); render(); }));
    const rows = yearRows(data.players, data.rotation, year);
    const names = data.players.map((p) => p.name);
    const pick = (r: RotationRow, k: 'p1' | 'p2') => {
      const val = r[k];
      // 시트 값이 현재 명단에 없으면(퇴단 등) 브라우저가 첫 옵션을 대신 보여줘 관리자·비관리자 화면이 달라진다 — 저장된 값을 옵션으로 앞에 끼워 넣는다.
      const extra = val && !names.includes(val) ? `<option selected>${esc(val)}</option>` : '';
      return `<select data-y="${r.year}" data-m="${r.month}" data-k="${k}">${extra}${names.map((n) => `<option ${n === val ? 'selected' : ''}>${esc(n)}</option>`).join('')}</select>`;
    };
    $('app').innerHTML = `<table class="tbl"><thead><tr><th>월</th><th>당번 1</th><th>당번 2</th><th class="c">완료</th></tr></thead><tbody>${rows.map((r) => { const cur = r.year === now.getFullYear() && r.month === now.getMonth() + 1; return `<tr class="${cur ? 'row-current' : ''}"><td>${r.month}월${cur ? ' <span class="label">이번 달</span>' : ''}</td><td>${isAdmin() ? pick(r, 'p1') : esc(r.p1)}</td><td>${isAdmin() ? pick(r, 'p2') : esc(r.p2)}</td><td class="c">${isAdmin() ? `<input type="checkbox" data-y="${r.year}" data-m="${r.month}" data-k="done" ${r.done ? 'checked' : ''}>` : r.done ? '✓' : ''}</td></tr>`; }).join('')}</tbody></table>`;
    $('app').querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-k]').forEach((el) => (el.onchange = async () => {
      const y = Number(el.dataset.y), m = Number(el.dataset.m);
      const r = yearRows(data!.players, data!.rotation, y).find((x) => x.month === m)!;
      const next: RotationRow = { ...r, [el.dataset.k!]: el.dataset.k === 'done' ? (el as HTMLInputElement).checked : el.value } as RotationRow;
      try { await write('writeRotation', serializeRotation(next)); toast('저장됨'); } catch (e) { toast((e as Error).message); }
    }));
  }
  window.addEventListener('wfc:admin', render);
  onData((d) => { data = d; render(); });
</script>
