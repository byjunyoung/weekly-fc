---
import Shell from '../layouts/Shell.astro';
---
<Shell title="홈">
  <div class="page-head"><h1>홈</h1><div class="actions"><span class="muted" id="stamp"></span></div></div>
  <div id="app"></div>
</Shell>
<script>
  import { onData, loadVideos } from '../lib/api';
  import { getMe } from '../lib/me';
  import { href } from '../lib/url';
  import { esc, fmtDate, fmtWon, monthLabel, ytThumb, ytThumbBig } from '../lib/html';
  import { rotationFor } from '../lib/rotation';
  import { matchVideos } from '../lib/match-videos';
  import { fineSummary, ovr } from '../lib/stats';
  import { LINKS } from '../lib/rules';
  import type { Data, Video } from '../lib/types';

  const app = document.getElementById('app')!;
  let data: Data | null = null;
  let videos: Video[] | null = null;

  const nextMonthOf = (y: number, mo: number): { y: number; mo: number } => (mo >= 12 ? { y: y + 1, mo: 1 } : { y, mo: mo + 1 });

  /** 타일 하나 — 라벨·큰 값·보조 세 줄 고정. 높이가 전부 같아야 격자가 계단이 되지 않는다. */
  function tile(label: string, big: string, sub: string, to: string, extra = '', wide = false): string {
    const cls = `tile${wide ? ' tile-wide' : ''}`;
    const body = `<span class="tile-label">${esc(label)}</span><b class="tile-big">${big}</b>${extra}<span class="tile-sub">${sub}</span>`;
    return to.startsWith('http')
      ? `<a class="${cls}" href="${to}" target="_blank" rel="noopener">${body}</a>`
      : `<a class="${cls}" href="${to}">${body}</a>`;
  }

  /** 봉사 타일 — 두 명은 대등하다. 한 명을 큰 값, 한 명을 보조 줄에 두면 위계가 생긴다. */
  function duoTile(label: string, a: string, b: string, sub: string, to: string): string {
    return `<a class="tile" href="${to}"><span class="tile-label">${esc(label)}</span><span class="tile-duo"><b>${esc(a)}</b><b>${esc(b)}</b></span><span class="tile-sub">${sub}</span></a>`;
  }

  /** 좌측 키 아트 — 최근 매치. 매치 탭과 같이 채널 영상만 본다(스펙 §3.4). */
  function art(): string {
    const m = matchVideos(videos ?? [])[0];
    const id = m?.id ?? '';
    const title = esc(m?.type ?? '') || '매치';
    const date = m?.date ?? '';
    const where = m?.location ?? '';
    return `<section class="art">
      ${id ? `<img src="${ytThumbBig(id)}" alt="" onerror="this.onerror=null;this.src='${ytThumb(id)}'">` : ''}
      <span class="art-kicker">최근 매치</span>
      <h2 class="art-title">${title}</h2>
      <p class="art-sub">${date ? esc(fmtDate(date)) : '날짜 미정'}${where ? ` · ${esc(where)}` : ''}</p>
      <div class="art-foot">
        <a class="chip" href="${href('/match/')}">매치 전체 →</a>
        ${id ? `<a class="chip" href="${href(`/match/?v=${encodeURIComponent(id)}`)}">영상 보기 →</a>` : ''}
      </div>
    </section>`;
  }

  function render() {
    if (!data) return;
    const d = data;
    const now = new Date(), y = now.getFullYear(), mo = now.getMonth() + 1;
    const duty = rotationFor(d.players, d.rotation, y, mo);
    const nm = nextMonthOf(y, mo);
    const dutyNext = rotationFor(d.players, d.rotation, nm.y, nm.mo);
    const fs = fineSummary(d.fines);
    const me = d.players.find((p) => p.num === getMe());
    const pos = (['GK', 'DF', 'MF', 'FW'] as const).map((k) => `${k} ${d.players.filter((p) => p.pos === k).length}`).join(' · ');
    const thumbs = (videos ?? []).slice(0, 4).map((v) => `<img src="${ytThumb(v.id)}" alt="" loading="lazy">`).join('');

    // 내 자리 — 이름을 고르면 내 OVR 이, 아니면 고르라는 안내가 같은 자리에 든다(빈 타일을 만들지 않는다).
    const meTile = me
      ? tile('내 선수', String(ovr(me) || '–'), `${esc(me.name)} · ${esc(me.pos) || '–'}`, href(`/squad/${me.num}/`))
      : `<button class="tile" id="pick-me" type="button"><span class="tile-label">내 선수</span><b class="tile-big">?</b><span class="tile-sub">이름을 고르면 내 카드가 뜹니다</span></button>`;

    app.innerHTML = `<div class="menu">
      ${art()}
      <div class="rail">
        ${meTile}
        ${tile('스쿼드', String(d.players.length), pos, href('/squad/'))}
        ${tile('매치', String(matchVideos(videos ?? []).length), '채널 영상', href('/match/'))}
        ${tile('라인업', '짜서 공유', '명단에서 골라 이미지로', href('/squad/'))}
        ${duoTile(`${monthLabel(y, mo)} 봉사`, duty.p1, duty.p2, duty.done ? '완료' : '대관비·조끼·정산', href('/rules/#duty'))}
        ${duoTile('다음 봉사', dutyNext.p1, dutyNext.p2, monthLabel(nm.y, nm.mo), href('/rules/#duty'))}
        ${tile('미납 벌금', fmtWon(fs.unpaid), `${fs.unpaidCount}건 · 내역 보기`, href('/rules/#fees'))}
        ${tile('최신 영상', String((videos ?? []).length), '채널에서 보기 · 매주 토요일 기록', LINKS.youtube, `<div class="tile-thumbs">${thumbs}</div>`, true)}
      </div>
    </div>`;
    document.getElementById('stamp')!.textContent = `${d.players.length}명 · 영상 ${(videos ?? []).length}`;
    document.getElementById('pick-me')?.addEventListener('click', () => (document.getElementById('me-btn') as HTMLElement | null)?.click());
  }
  window.addEventListener('wfc:me', render);
  onData((d) => { data = d; render(); });
  loadVideos().then((v) => { videos = v; render(); }).catch(() => { videos = []; render(); });
</script>
