---
import Shell from '../../layouts/Shell.astro';
export function getStaticPaths() { return Array.from({ length: 99 }, (_, i) => ({ params: { num: String(i + 1) } })); }
const { num } = Astro.params;
---
<Shell title={`선수 #${num}`}>
  <div class="page-head"><h1 id="title">선수 #{num}</h1><div class="actions" id="actions"></div></div>
  <div id="app" class="stack" data-num={num}></div>
  <div class="modal-bg" id="edit-modal"><div class="modal modal-wide"><h2>선수 편집</h2><form class="form" id="edit-form"></form><div class="foot"><button class="danger" id="del">삭제</button><span style="flex:1"></span><button data-close="edit-modal">취소</button><button class="primary" id="save">저장</button></div></div></div>
  <!-- 아바타 에디터 — 위 edit-modal(관리자 전용)과 별개다. 잠금 없음(사용자 결정 2026-09-11):
       가입·PIN 없이 누구나 열어 저장할 수 있다. -->
  <div class="modal-bg" id="avatar-modal"><div class="modal"><h2>아바타 편집</h2>
    <div class="row" id="avatar-preview" style="justify-content:center;margin-bottom:var(--gap)"></div>
    <div class="stack" id="avatar-picker"></div>
    <div class="foot"><button data-close="avatar-modal">취소</button><button class="primary" id="avatar-save">저장</button></div>
  </div></div>
</Shell>
<script>
  import { onData, isAdmin, write, writeAvatar, fetchFull, serializePlayer } from '../../lib/api.ts';
  import { href } from '../../lib/url.ts';
  import { esc, fmtDate, fmtWon, monthLabel, toast } from '../../lib/html.ts';
  import { attendance, wins, band, RATE_CUTS } from '../../lib/stats.ts';
  import { nextDuty } from '../../lib/rotation.ts';
  import { playerCard, STAT_KO } from '../../components/player-card.ts';
  import { avatarSvg } from '../../components/avatar.ts';
  import { PARTS, avatarSpecFor, serializeAvatar, type AvatarSpec } from '../../lib/avatar.ts';
  import { countUp } from '../../lib/motion.ts';
  import { STAT_KEYS, type Data, type Player } from '../../lib/types.ts';

  const app = document.getElementById('app')!;
  const num = Number(app.dataset.num);
  const isNew = new URLSearchParams(location.search).get('new') === '1';
  let data: Data | null = null;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) => (b.onclick = () => $(b.dataset.close!).classList.remove('show')));

  function render() {
    if (!data) return;
    const p = data.players.find((x) => x.num === num);
    $('actions').innerHTML = isAdmin() ? `<button id="edit">편집</button>` : '';
    if (isAdmin()) $('edit').onclick = () => openEdit(p);
    if (!p) { $('title').textContent = `선수 #${num}`; app.innerHTML = `<p class="muted">이 번호의 선수가 없습니다.${isAdmin() ? ' 편집으로 추가할 수 있습니다.' : ''}</p>`; if (isNew && isAdmin()) openEdit(undefined); return; }
    $('title').textContent = p.name;
    const my = data.matches.filter((m) => m.attendees.includes(p.name));
    const a = attendance(p.name, data.matches), w = wins(p.name, data.matches);
    const fines = data.fines.filter((f) => f.player === p.name);
    const unpaid = fines.filter((f) => !f.paid).reduce((s, f) => s + f.amount, 0);
    const duty = nextDuty(data.players, data.rotation, p.name);
    const avatarHtml = `<button type="button" id="avatar-edit-btn" class="avatar-btn" title="아바타 편집">${avatarSvg(avatarSpecFor(p.num, p.avatar), 120, p.num)}</button>`;
    app.innerHTML = `${playerCard(p, avatarHtml)}
      <div class="cards">
        <div class="card"><h2>출석</h2><div class="big">${a.total ? `<span class="val val-${band(a.rate, RATE_CUTS)}" id="pc-att-val">${a.rate}%</span>` : '–'}</div><p class="muted">${a.attended} / ${a.total} 매치</p></div>
        <div class="card"><h2>승률</h2><div class="big">${w.played ? `${w.rate}%` : '–'}</div><p class="muted">${w.won}승 / 결과 있는 ${w.played} 매치</p></div>
        <div class="card"><h2>벌금</h2><div class="big ${unpaid ? 'warn' : ''}" id="pc-fine-big">${fmtWon(unpaid)}</div><p class="muted">미납 · 누계 ${fmtWon(fines.reduce((s, f) => s + f.amount, 0))} (${fines.length}건)</p></div>
        <div class="card"><h2>봉사</h2><div class="big">${duty ? monthLabel(duty.year, duty.month) : '–'}</div><p class="muted">${p.rot ? `순번 ${p.rot} · 다음 차례` : '로테이션 제외'}</p></div>
      </div>
      <div class="card"><h2>참여 이력</h2>${my.length ? `<div class="tbl-wrap"><table class="tbl"><thead><tr><th>날짜</th><th>장소</th><th>유형</th><th>결과</th></tr></thead><tbody>${my.map((m) => { const won = m.winner && m.teams.find((t) => t.name === m.winner)?.players.includes(p.name); return `<tr><td><a href="${href(`/match/?d=${encodeURIComponent(m.id)}`)}">${fmtDate(m.date)}</a></td><td>${esc(m.location) || '–'}</td><td>${esc(m.type) || '–'}</td><td>${m.winner ? (won ? '<span class="val val-a">승</span>' : '<span class="val val-d">패</span>') : '<span class="muted">–</span>'}</td></tr>`; }).join('')}</tbody></table></div>` : '<p class="muted">아직 참석 기록이 없습니다.</p>'}</div>
      ${fines.length ? `<div class="card"><h2>벌금 내역</h2><div class="tbl-wrap"><table class="tbl"><thead><tr><th>날짜</th><th>유형</th><th class="r">금액</th><th>납부</th></tr></thead><tbody>${fines.map((f) => `<tr><td>${fmtDate(f.date)}</td><td>${esc(f.type)}</td><td class="r">${fmtWon(f.amount)}</td><td>${f.paid ? '완료' : '<span class="warn">미납</span>'}</td></tr>`).join('')}</tbody></table></div></div>` : ''}`;
    $('avatar-edit-btn').onclick = () => openAvatarEditor(p);
    // 카운트업(8절) — OVR·출석률·정산(미납) 합계를 0에서 실제 값으로. "–"로
    // 표시되는(값 없음) 자리는 셀 게 없으니 그대로 둔다. reduced-motion은
    // countUp 내부에서 처리한다(바로 최종값, 프레임 루프 없음).
    const ovrEl = app.querySelector<HTMLElement>('[data-ovr]');
    if (ovrEl) { const target = Number(ovrEl.dataset.ovr); if (target > 0) countUp(ovrEl, target); }
    const attEl = document.getElementById('pc-att-val');
    if (a.total > 0 && attEl) countUp(attEl, a.rate, (n) => `${n}%`);
    countUp($('pc-fine-big'), unpaid, fmtWon);
  }

  // ── 아바타 에디터 — PIN 없음. 부품을 고르면 즉시 미리보기에 반영하고,
  // 저장은 writeAvatar(잠금 없는 전용 액션)만 호출한다. ──────────────
  let editSpec: AvatarSpec = { face: 0, hair: 0, skin: 0, eyes: 0, kit: '#333a45' };
  let editNum = num;
  function renderAvatarPreview() { $('avatar-preview').innerHTML = avatarSvg(editSpec, 120); }
  function renderAvatarPicker() {
    const group = (key: 'face' | 'hair' | 'skin' | 'eyes', title: string) => `<div><div class="label label-gap">${title}</div><div class="pick-list" data-cat="${key}">${PARTS[key].map((opt, i) => `<button type="button" class="${editSpec[key] === i ? 'primary' : ''}" data-i="${i}">${esc(opt.label)}</button>`).join('')}</div></div>`;
    $('avatar-picker').innerHTML = `${group('face', '얼굴형')}${group('hair', '헤어')}${group('skin', '피부')}${group('eyes', '눈')}
      <div><div class="label label-gap">유니폼 색</div><div class="pick-list" data-cat="kit">${PARTS.kit.map((hex) => `<button type="button" class="${editSpec.kit === hex ? 'primary' : ''}" style="background:${hex}" data-hex="${hex}" aria-label="${hex}">&nbsp;</button>`).join('')}</div></div>`;
    $('avatar-picker').querySelectorAll<HTMLButtonElement>('.pick-list button').forEach((b) => {
      b.onclick = () => {
        const cat = (b.parentElement as HTMLElement).dataset.cat!;
        editSpec = cat === 'kit' ? { ...editSpec, kit: b.dataset.hex! } : { ...editSpec, [cat]: Number(b.dataset.i) };
        renderAvatarPicker();
        renderAvatarPreview();
      };
    });
  }
  function openAvatarEditor(p: Player) {
    editNum = p.num;
    editSpec = avatarSpecFor(p.num, p.avatar);
    renderAvatarPicker();
    renderAvatarPreview();
    $('avatar-modal').classList.add('show');
  }
  $('avatar-save').onclick = async () => {
    try {
      await writeAvatar(editNum, serializeAvatar(editSpec));
      $('avatar-modal').classList.remove('show');
      toast('아바타 저장됨');
    } catch (e) { toast((e as Error).message); }
  };

  const F = (name: string, label: string, value: string | number, type = 'text', extra = '') => `<label>${label}<input name="${name}" type="${type}" value="${esc(value)}" ${extra}></label>`;
  async function openEdit(p: Player | undefined) {
    let full = p;
    if (p) { try { full = (await fetchFull()).players.find((x) => x.num === num) ?? p; } catch { toast('전화번호를 못 불러와 편집을 열 수 없습니다. 다시 시도해주세요'); return; } }
    const v = full ?? { num, name: '', pos: '' as const, detail: '', foot: '', vest: null, note: '', pace: 70, dribble: 70, pass: 70, shoot: 70, defend: 70, stamina: 70, rot: null, phone: '' };
    ($('edit-form') as HTMLFormElement).innerHTML = `
      ${F('num', '번호', v.num, 'number', 'min="1" max="99" required')}${F('name', '이름', v.name, 'text', 'required')}
      <label>포지션<select name="pos">${['', 'GK', 'DF', 'MF', 'FW'].map((x) => `<option ${x === v.pos ? 'selected' : ''}>${x}</option>`).join('')}</select></label>
      ${F('detail', '세부 포지션', v.detail)}${F('foot', '주발', v.foot)}${F('vest', '조끼', v.vest ?? '', 'number')}${F('rot', '봉사 순번 (빈칸=제외)', v.rot ?? '', 'number')}${F('phone', '전화 (공개 안 됨)', v.phone ?? '', 'tel')}
      ${STAT_KEYS.map((k) => F(k, STAT_KO[k], v[k], 'number', 'min="1" max="99"')).join('')}
      <label class="full">메모<input name="note" value="${esc(v.note)}"></label>`;
    $('del').hidden = !p;
    $('edit-modal').classList.add('show');
  }
  $('save').onclick = async () => {
    const fd = new FormData($('edit-form') as HTMLFormElement);
    const g = (k: string) => String(fd.get(k) ?? '').trim();
    const n = (k: string) => (g(k) === '' ? null : Number(g(k)));
    // avatar는 이 폼에 없는 필드다(잠금 없는 별도 에디터가 전담) — writePlayer가 열을 통째로
    // 덮어쓰므로, 여기서 실어 보내지 않으면 빈 문자열로 지워진다. 현재 저장된 값을 그대로 실어 보존한다.
    const p: Player = { num: Number(g('num')), name: g('name'), pos: g('pos') as Player['pos'], detail: g('detail'), foot: g('foot'), vest: n('vest'), note: g('note'), rot: n('rot'),
      pace: n('pace') ?? 0, dribble: n('dribble') ?? 0, pass: n('pass') ?? 0, shoot: n('shoot') ?? 0, defend: n('defend') ?? 0, stamina: n('stamina') ?? 0, phone: g('phone'),
      avatar: data?.players.find((x) => x.num === num)?.avatar ?? '' };
    if (!p.num || !p.name) { toast('번호와 이름은 필수'); return; }
    const numChanged = p.num !== num;
    if (numChanged) {
      const clash = data?.players.find((x) => x.num === p.num);
      if (clash) { toast(`${p.num}번은 이미 ${clash.name}의 번호입니다`); return; }
    }
    try {
      await write('writePlayer', serializePlayer(p));
      // 번호를 바꾼 경우: 새 번호로 먼저 쓴 뒤에만 옛 번호 행을 지운다 — 실패해도 선수 정보를 잃지 않도록.
      if (numChanged && data?.players.some((x) => x.num === num)) {
        try { await write('deletePlayer', { num }); } catch (e) { toast(`저장은 됐지만 이전 번호(${num}) 삭제 실패: ${(e as Error).message}`); }
      }
      $('edit-modal').classList.remove('show'); toast('저장됨');
      if (numChanged) location.href = href(`/squad/${p.num}/`);
    } catch (e) { toast((e as Error).message); }
  };
  $('del').onclick = async () => { if (!confirm('이 선수를 명단에서 지울까요?')) return; try { await write('deletePlayer', { num }); location.href = href('/squad/'); } catch (e) { toast((e as Error).message); } };
  window.addEventListener('wfc:admin', render);
  onData((d) => { data = d; render(); });
</script>
